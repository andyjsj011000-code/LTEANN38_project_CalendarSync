# Set these in the server process environment. This file is not loaded implicitly.
# Persist the key and database together. Never commit the real key.
WEB_DATA_KEY=REPLACE_WITH_A_PERSISTENT_FERNET_KEY
WEB_DATABASE_PATH=web_service/var/web-foundation.sqlite3
WEB_ORIGIN=http://localhost:8080
# Configure all three to enable real school sign-in.
WEB_ENTRA_TENANT_ID=
WEB_ENTRA_CLIENT_ID=
WEB_ENTRA_CLIENT_SECRET=
