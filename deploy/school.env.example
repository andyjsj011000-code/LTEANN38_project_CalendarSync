# Copy to /etc/calendarsync/web.env (root-owned, 0600). Do not put real values in Git.
WEB_ORIGIN=https://calendar.example.school
WEB_DATABASE_PATH=/var/lib/calendarsync/school.sqlite3
WEB_DATA_KEY=REPLACE_WITH_A_PERSISTENT_NEW_FERNET_KEY
WEB_ENTRA_TENANT_ID=REPLACE_WITH_SCHOOL_TENANT_UUID
WEB_ENTRA_CLIENT_ID=REPLACE_WITH_WEB_APP_UUID
WEB_ENTRA_CLIENT_SECRET=REPLACE_WITH_WEB_APP_SECRET
WEB_SESSION_SECONDS=3600
WEB_IDLE_SECONDS=900
WEB_ACCESS_SECONDS=60
# No WEB_ALLOW_LOCAL_LOGIN in production.
# Dedicated Oracle user with SELECT on a read-only MASTER_CALENDARS synonym/view only.
WEB_ORACLE_USER=REPLACE_WITH_READ_ONLY_USER
WEB_ORACLE_PASSWORD=REPLACE_WITH_PASSWORD
WEB_ORACLE_DSN=REPLACE_WITH_TLS_WALLET_ALIAS
# This is the existing bot's encryption key, NOT WEB_DATA_KEY.
WEB_ORACLE_DATA_KEY=REPLACE_WITH_EXISTING_SOURCE_KEY
WEB_ORACLE_WALLET_DIR=/etc/calendarsync/wallet
WEB_ORACLE_WALLET_PASSWORD=REPLACE_WITH_WALLET_PASSWORD
