# Copy to deploy/school.test.env; keep real values out of Git.
WEB_ORIGIN=https://calendar-test.example.school
WEB_DATABASE_PATH=/var/lib/calendarsync-test/test.sqlite3
WEB_DATA_KEY=REPLACE_WITH_PERSISTENT_WEB_KEY
WEB_ENTRA_TENANT_ID=REPLACE_WITH_SCHOOL_TENANT_UUID
WEB_ENTRA_CLIENT_ID=REPLACE_WITH_WEB_APP_UUID
WEB_ENTRA_CLIENT_SECRET=REPLACE_WITH_SERVER_SECRET
WEB_SESSION_SECONDS=28800
WEB_IDLE_SECONDS=1800
WEB_ACCESS_SECONDS=60
# direct: use each user's delegated Graph connection; oracle: reuse the read-only bridge.
WEB_INGESTION_MODE=direct
WEB_OPENAI_API_KEY=REPLACE_WITH_AI_KEY
WEB_LLM_MODEL=gpt-4o-mini
WEB_AI_IMAGES_ENABLED=1
# Base64url-encoded PKCS8 DER P-256 key, generated once and retained.
WEB_VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
WEB_VAPID_SUBJECT=mailto:REPLACE_WITH_OPERATOR_EMAIL
# Optional Oracle settings only when WEB_INGESTION_MODE=oracle.
# WEB_ORACLE_USER=read_only_user
# WEB_ORACLE_PASSWORD=private_value
# WEB_ORACLE_DSN=wallet_alias
# WEB_ORACLE_DATA_KEY=existing_bot_data_key
# WEB_ORACLE_WALLET_DIR=/etc/calendarsync/wallet
# WEB_ORACLE_WALLET_PASSWORD=private_value
