# Example keys only. Enter real values privately in the new Render service.
# Do not use the loopback launcher's WEB_*-only env-file loader for DATABASE_URL.
WEB_STORAGE_BACKEND=postgresql
WEB_INGESTION_MODE=direct
WEB_DATABASE_SCHEMA=calendarsync_web
WEB_DATABASE_SSLMODE=require
DATABASE_URL=
WEB_ORIGIN=
WEB_DATA_KEY=
WEB_ENTRA_TENANT_ID=
WEB_ENTRA_CLIENT_ID=
WEB_ENTRA_CLIENT_SECRET=
WEB_OPENAI_API_KEY=
# Optional Web Push credentials must be generated/persisted separately.
WEB_VAPID_PRIVATE_KEY=
WEB_VAPID_SUBJECT=
