# Replace every calendar.example.school and certificate path before enabling.
# Put the limit_req_zone directives in nginx's http {} context.
limit_req_zone $binary_remote_addr zone=school_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=school_api:10m rate=120r/m;
server {
    listen 80;
    server_name calendar.example.school;
    return 301 https://calendar.example.school$request_uri;
}
server {
    listen 443 ssl;
    server_name calendar.example.school;
    ssl_certificate /etc/letsencrypt/live/calendar.example.school/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/calendar.example.school/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    # Callback authorization codes and private URLs must not enter access logs.
    access_log off;
    # Nginx errors can include upstream URLs. Send failures to a restricted sink;
    # do not enable debug/error URL logging for the authentication locations.
    error_log /dev/null crit;
    proxy_set_header Host calendar.example.school;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Cookie $http_cookie;
    proxy_connect_timeout 5s;
    proxy_read_timeout 115s;
    location ~ ^/auth/(login|callback)$ {
        limit_req zone=school_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
    }
    location / {
        limit_req zone=school_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
    }
}
